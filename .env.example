# Database Configuration
DATABASE_URL=postgresql://court_user:court_password@localhost:5432/court_simulation

# LLM Provider Configuration
# Choose: openai, anthropic, or local
LLM_PROVIDER=openai
LLM_MAX_ATTEMPTS=3
LLM_LOG_PATH=logs/llm_interactions.jsonl

# OpenAI Configuration (structured outputs need gpt-4o or newer)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=  # optional: any OpenAI-compatible endpoint

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high
ANTHROPIC_REFUSAL_FALLBACK=True

# Local model Configuration (any OpenAI-compatible server, e.g. Ollama)
LOCAL_MODEL=llama3.1
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_JSON_MODE=True

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
